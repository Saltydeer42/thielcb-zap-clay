# Copy to .env and fill in real values
# Crunchbase API key – get it from your Crunchbase account settings
CRUNCHBASE_API_KEY=

# Clay webhook URL – Monitor webhook URL from Clay
ZAPIER_WEBHOOK_URL=

# Investor names (comma-separated). Fixed to Peter Thiel for this project.
VC_FIRM_NAMES="Peter Thiel"

# Optional logging level
LOG_LEVEL=INFO
